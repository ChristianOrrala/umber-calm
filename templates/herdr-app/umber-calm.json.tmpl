{
  "background": "{{ term.background }}",
  "foreground": "{{ term.foreground }}",
  "selection": "{{ term.selection_bg }}",
  "cursor": "{{ term.cursor }}",
  "ansi": [
    "{{ ansi.black }}",
    "{{ ansi.red }}",
    "{{ ansi.green }}",
    "{{ ansi.yellow }}",
    "{{ ansi.blue }}",
    "{{ ansi.magenta }}",
    "{{ ansi.cyan }}",
    "{{ ansi.white }}",
    "{{ ansi.bright_black }}",
    "{{ ansi.bright_red }}",
    "{{ ansi.bright_green }}",
    "{{ ansi.bright_yellow }}",
    "{{ ansi.bright_blue }}",
    "{{ ansi.bright_magenta }}",
    "{{ ansi.bright_cyan }}",
    "{{ ansi.bright_white }}"
  ],
  "colors": {
    "foreground": "{{ ui.text }}",
    "surface": "{{ ui.bg }}",
    "canvas": "{{ ui.chrome }}",
    "chrome": "{{ ui.chrome }}",
    "popover": "{{ ui.surface }}",
    "raised": "{{ ui.surface }}",
    "hover": "{{ ui.selection_bg | alpha(60) }}",
    "selected": "{{ ui.text | alpha(17) }}",
    "border": "{{ ui.border_strong }}",
    "input": "{{ ui.border_strong }}",
    "ring": "{{ ui.border }}",
    "muted": "{{ ui.text_secondary }}",
    "dim": "{{ ui.text_secondary }}",
    "accent": "{{ ui.focus }}",
    "accent_foreground": "{{ term.cursor_text }}",
    "solid": "{{ ui.text }}",
    "solid_foreground": "{{ ui.bg }}",
    "working": "{{ diag.warning }}",
    "blocked": "{{ ansi.bright_red }}",
    "done": "{{ diag.ok }}",
    "idle": "{{ ui.text_secondary }}",
    "unknown": "{{ ui.text_secondary }}"
  }
}
