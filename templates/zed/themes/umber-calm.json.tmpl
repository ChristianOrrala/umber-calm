{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Umber Calm",
  "author": "The Umber Calm contributors",
  "themes": [
    {
      "name": "Umber Calm",
      "appearance": "dark",
      "style": {
        "background": "{{ ui.chrome }}",
        "border": "{{ ui.border_strong }}",
        "border.variant": "{{ ui.border }}",
        "border.focused": "{{ ui.focus }}",
        "text": "{{ ui.text }}",
        "text.muted": "{{ ui.text_secondary }}",
        "text.placeholder": "{{ ui.text_dim }}",
        "text.accent": "{{ blue }}",
        "icon": "{{ ui.text }}",
        "icon.muted": "{{ ui.text_secondary }}",
        "element.hover": "{{ ui.surface }}",
        "element.selected": "{{ ui.selection_bg }}",
        "surface.background": "{{ ui.surface }}",
        "elevated_surface.background": "{{ ui.surface }}",
        "panel.background": "{{ ui.surface }}",
        "status_bar.background": "{{ ui.surface }}",
        "title_bar.background": "{{ ui.chrome }}",
        "tab_bar.background": "{{ ui.chrome }}",
        "tab.active_background": "{{ ui.bg }}",
        "tab.inactive_background": "{{ ui.chrome }}",
        "editor.background": "{{ ui.bg }}",
        "editor.foreground": "{{ ui.text }}",
        "editor.gutter.background": "{{ ui.bg }}",
        "editor.active_line.background": "{{ ui.surface }}",
        "editor.line_number": "{{ ui.line_number }}",
        "editor.active_line_number": "{{ ui.line_number_active }}",
        "editor.indent_guide": "{{ ui.border_strong }}",
        "editor.indent_guide_active": "{{ ui.border }}",
        "search.match_background": "{{ diag.search | alpha(2E) }}",
        "error": "{{ diag.error }}",
        "warning": "{{ diag.warning }}",
        "info": "{{ diag.info }}",
        "hint": "{{ diag.hint }}",
        "success": "{{ diag.ok }}",
        "created": "{{ diag.diff_add }}",
        "deleted": "{{ diag.diff_delete }}",
        "modified": "{{ diag.diff_change }}",
        "terminal.background": "{{ term.background }}",
        "terminal.foreground": "{{ term.foreground }}",
        "terminal.ansi.black": "{{ ansi.black }}",
        "terminal.ansi.red": "{{ ansi.red }}",
        "terminal.ansi.green": "{{ ansi.green }}",
        "terminal.ansi.yellow": "{{ ansi.yellow }}",
        "terminal.ansi.blue": "{{ ansi.blue }}",
        "terminal.ansi.magenta": "{{ ansi.magenta }}",
        "terminal.ansi.cyan": "{{ ansi.cyan }}",
        "terminal.ansi.white": "{{ ansi.white }}",
        "terminal.ansi.bright_black": "{{ ansi.bright_black }}",
        "terminal.ansi.bright_red": "{{ ansi.bright_red }}",
        "terminal.ansi.bright_green": "{{ ansi.bright_green }}",
        "terminal.ansi.bright_yellow": "{{ ansi.bright_yellow }}",
        "terminal.ansi.bright_blue": "{{ ansi.bright_blue }}",
        "terminal.ansi.bright_magenta": "{{ ansi.bright_magenta }}",
        "terminal.ansi.bright_cyan": "{{ ansi.bright_cyan }}",
        "terminal.ansi.bright_white": "{{ ansi.bright_white }}",
        "players": [
          { "cursor": "{{ term.cursor }}", "background": "{{ term.cursor }}", "selection": "{{ ui.selection_bg }}" }
        ],
        "syntax": {
          "keyword": { "color": "{{ syntax.keyword }}" },
          "preproc": { "color": "{{ syntax.preproc }}" },
          "function": { "color": "{{ syntax.function }}" },
          "tag": { "color": "{{ syntax.tag }}" },
          "type": { "color": "{{ syntax.type }}" },
          "constructor": { "color": "{{ syntax.type }}" },
          "attribute": { "color": "{{ syntax.attribute }}" },
          "string": { "color": "{{ syntax.string }}" },
          "string.escape": { "color": "{{ syntax.escape }}" },
          "string.regex": { "color": "{{ syntax.escape }}" },
          "number": { "color": "{{ syntax.constant }}" },
          "boolean": { "color": "{{ syntax.constant }}" },
          "constant": { "color": "{{ syntax.constant }}" },
          "variable": { "color": "{{ syntax.variable }}" },
          "variable.special": { "color": "{{ syntax.builtin }}" },
          "property": { "color": "{{ syntax.variable }}" },
          "operator": { "color": "{{ syntax.operator }}" },
          "punctuation": { "color": "{{ syntax.operator }}" },
          "comment": { "color": "{{ syntax.comment }}", "font_style": "italic" },
          "title": { "color": "{{ syntax.heading }}", "font_weight": 700 },
          "link_uri": { "color": "{{ syntax.link }}" }
        }
      }
    }
  ]
}
