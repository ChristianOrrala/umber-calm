/* Umber Calm {{ meta.palette_version }} — generated from {{ meta.template }}. Do not edit. MIT License. */
.theme-dark {
  --background-primary: {{ ui.bg }};
  --background-primary-alt: {{ ui.surface }};
  --background-secondary: {{ ui.surface }};
  --background-secondary-alt: {{ ui.chrome }};
  --background-modifier-border: {{ ui.border_strong }};
  --text-normal: {{ ui.text }};
  --text-muted: {{ ui.text_secondary }};
  --text-faint: {{ ui.text_dim }};
  --text-accent: {{ blue }};
  --text-accent-hover: {{ ansi.bright_blue }};
  --interactive-accent: {{ blue }};
  --interactive-accent-hover: {{ ansi.bright_blue }};
  --text-selection: {{ ui.selection_bg }};
  --text-highlight-bg: {{ diag.search | alpha(2E) }};
  --code-normal: {{ syntax.variable }};
  --code-comment: {{ syntax.comment }};
  --code-keyword: {{ syntax.keyword }};
  --code-function: {{ syntax.function }};
  --code-string: {{ syntax.string }};
  --code-value: {{ syntax.constant }};
  --code-property: {{ syntax.variable }};
  --code-tag: {{ syntax.tag }};
  --code-operator: {{ syntax.operator }};
  --code-punctuation: {{ syntax.operator }};
}
