{
  "name": "Umber Calm",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "foreground": "{{ ui.text }}",
    "focusBorder": "{{ ui.focus | alpha(80) }}",
    "selection.background": "{{ ui.selection_bg }}",
    "widget.shadow": "#00000060",
    "textLink.foreground": "{{ syntax.link }}",
    "textLink.activeForeground": "{{ ansi.bright_blue }}",
    "editor.background": "{{ ui.bg }}",
    "editor.foreground": "{{ ui.text }}",
    "editor.lineHighlightBackground": "{{ ui.surface }}",
    "editor.selectionBackground": "{{ ui.selection_bg }}",
    "editor.inactiveSelectionBackground": "{{ ui.selection_bg | alpha(99) }}",
    "editor.selectionHighlightBackground": "{{ ui.selection_bg | alpha(80) }}",
    "editor.findMatchBackground": "{{ diag.search }}",
    "editor.findMatchForeground": "{{ ui.text }}",
    "editor.findMatchHighlightBackground": "{{ diag.search | alpha(2E) }}",
    "editor.findMatchHighlightForeground": "{{ ui.bg }}",
    "editor.wordHighlightBackground": "{{ blue | alpha(26) }}",
    "editor.wordHighlightStrongBackground": "{{ blue | alpha(38) }}",
    "editorCursor.foreground": "{{ term.cursor }}",
    "editorCursor.background": "{{ term.cursor_text }}",
    "editorLineNumber.foreground": "{{ ui.line_number }}",
    "editorLineNumber.activeForeground": "{{ ui.line_number_active }}",
    "editorIndentGuide.background1": "{{ ui.border_strong }}",
    "editorIndentGuide.activeBackground1": "{{ ui.border }}",
    "editorWhitespace.foreground": "{{ ui.border_strong }}",
    "editorRuler.foreground": "{{ ui.border_strong }}",
    "editorBracketMatch.background": "{{ ui.selection_bg }}",
    "editorBracketMatch.border": "{{ ui.text_secondary }}",
    "editorBracketHighlight.foreground1": "{{ syntax.keyword }}",
    "editorBracketHighlight.foreground2": "{{ syntax.constant }}",
    "editorBracketHighlight.foreground3": "{{ syntax.function }}",
    "editorBracketHighlight.foreground4": "{{ syntax.string }}",
    "editorBracketHighlight.foreground5": "{{ syntax.type }}",
    "editorBracketHighlight.foreground6": "{{ syntax.operator }}",
    "editorBracketHighlight.unexpectedBracket.foreground": "{{ diag.error }}",
    "editorError.foreground": "{{ diag.error }}",
    "editorWarning.foreground": "{{ diag.warning }}",
    "editorInfo.foreground": "{{ diag.info }}",
    "editorHint.foreground": "{{ diag.hint }}",
    "editorGutter.addedBackground": "{{ diag.diff_add }}",
    "editorGutter.modifiedBackground": "{{ diag.diff_change }}",
    "editorGutter.deletedBackground": "{{ diag.diff_delete }}",
    "diffEditor.insertedLineBackground": "{{ diag.diff_add | alpha(38) }}",
    "diffEditor.removedLineBackground": "{{ diag.diff_delete | alpha(38) }}",
    "editorWidget.background": "{{ ui.surface }}",
    "editorWidget.border": "{{ ui.border_strong }}",
    "editorHoverWidget.background": "{{ ui.surface }}",
    "editorHoverWidget.border": "{{ ui.border_strong }}",
    "editorSuggestWidget.background": "{{ ui.surface }}",
    "editorSuggestWidget.border": "{{ ui.border_strong }}",
    "editorSuggestWidget.selectedBackground": "{{ ui.selection_bg }}",
    "editorSuggestWidget.highlightForeground": "{{ diag.search }}",
    "editorInlayHint.foreground": "{{ ui.text_secondary }}",
    "editorInlayHint.background": "{{ ui.surface }}",
    "editorCodeLens.foreground": "{{ ui.text_secondary }}",
    "editorGroupHeader.tabsBackground": "{{ ui.chrome }}",
    "editorGroup.border": "{{ ui.border }}",
    "tab.activeBackground": "{{ ui.bg }}",
    "tab.activeForeground": "{{ ui.text }}",
    "tab.activeBorderTop": "{{ ui.focus }}",
    "tab.inactiveBackground": "{{ ui.chrome }}",
    "tab.inactiveForeground": "{{ ui.text_secondary }}",
    "tab.hoverBackground": "{{ ui.surface }}",
    "tab.border": "{{ ui.chrome }}",
    "sideBar.background": "{{ ui.surface }}",
    "sideBar.foreground": "{{ ui.text }}",
    "sideBar.border": "{{ ui.chrome }}",
    "sideBarSectionHeader.background": "{{ ui.surface }}",
    "sideBarTitle.foreground": "{{ ui.text_secondary }}",
    "activityBar.background": "{{ ui.chrome }}",
    "activityBar.foreground": "{{ ui.text }}",
    "activityBar.inactiveForeground": "{{ ui.text_secondary }}",
    "activityBar.activeBorder": "{{ ui.focus }}",
    "activityBarBadge.background": "{{ blue }}",
    "activityBarBadge.foreground": "{{ ui.bg }}",
    "titleBar.activeBackground": "{{ ui.chrome }}",
    "titleBar.activeForeground": "{{ ui.text_secondary }}",
    "titleBar.inactiveBackground": "{{ ui.chrome }}",
    "titleBar.inactiveForeground": "{{ ui.text_dim }}",
    "statusBar.background": "{{ ui.surface }}",
    "statusBar.foreground": "{{ ui.text_secondary }}",
    "statusBar.border": "{{ ui.chrome }}",
    "statusBar.debuggingBackground": "{{ diag.warning }}",
    "statusBar.debuggingForeground": "{{ ui.bg }}",
    "statusBarItem.remoteBackground": "{{ ui.surface }}",
    "statusBarItem.remoteForeground": "{{ ui.text }}",
    "panel.background": "{{ ui.bg }}",
    "panel.border": "{{ ui.border_strong }}",
    "panelTitle.activeForeground": "{{ ui.text }}",
    "panelTitle.activeBorder": "{{ ui.focus }}",
    "panelTitle.inactiveForeground": "{{ ui.text_secondary }}",
    "list.activeSelectionBackground": "{{ ui.selection_bg }}",
    "list.activeSelectionForeground": "{{ ui.selection_fg }}",
    "list.inactiveSelectionBackground": "{{ ui.selection_bg | alpha(99) }}",
    "list.hoverBackground": "{{ ui.surface }}",
    "list.highlightForeground": "{{ diag.search }}",
    "list.focusOutline": "{{ ui.focus | alpha(80) }}",
    "list.errorForeground": "{{ diag.error }}",
    "list.warningForeground": "{{ diag.warning }}",
    "input.background": "{{ ui.bg }}",
    "input.foreground": "{{ ui.text }}",
    "input.border": "{{ ui.text_dim }}",
    "input.placeholderForeground": "{{ ui.text_secondary }}",
    "inputOption.activeBorder": "{{ ui.focus }}",
    "dropdown.background": "{{ ui.surface }}",
    "dropdown.border": "{{ ui.text_dim }}",
    "button.background": "{{ blue }}",
    "button.foreground": "{{ ui.bg }}",
    "button.hoverBackground": "{{ ansi.bright_blue }}",
    "button.secondaryBackground": "{{ ui.selection_bg }}",
    "button.secondaryForeground": "{{ ui.text }}",
    "badge.background": "{{ ui.selection_bg }}",
    "badge.foreground": "{{ ui.text }}",
    "scrollbarSlider.background": "{{ ui.border | alpha(66) }}",
    "scrollbarSlider.hoverBackground": "{{ ui.border | alpha(99) }}",
    "scrollbarSlider.activeBackground": "{{ ui.text_dim | alpha(99) }}",
    "gitDecoration.addedResourceForeground": "{{ diag.diff_add }}",
    "gitDecoration.modifiedResourceForeground": "{{ diag.diff_change }}",
    "gitDecoration.deletedResourceForeground": "{{ diag.diff_delete }}",
    "gitDecoration.untrackedResourceForeground": "{{ diag.ok }}",
    "gitDecoration.ignoredResourceForeground": "{{ ui.text_dim }}",
    "gitDecoration.conflictingResourceForeground": "{{ diag.warning }}",
    "notifications.background": "{{ ui.surface }}",
    "notifications.foreground": "{{ ui.text }}",
    "notificationsErrorIcon.foreground": "{{ diag.error }}",
    "notificationsWarningIcon.foreground": "{{ diag.warning }}",
    "notificationsInfoIcon.foreground": "{{ diag.info }}",
    "peekView.border": "{{ ui.border_strong }}",
    "peekViewEditor.background": "{{ ui.surface }}",
    "peekViewResult.background": "{{ ui.chrome }}",
    "peekViewTitle.background": "{{ ui.surface }}",
    "breadcrumb.foreground": "{{ ui.text_secondary }}",
    "breadcrumb.focusForeground": "{{ ui.text }}",
    "terminal.background": "{{ term.background }}",
    "terminal.foreground": "{{ term.foreground }}",
    "terminalCursor.foreground": "{{ term.cursor }}",
    "terminal.selectionBackground": "{{ term.selection_bg }}",
    "terminal.ansiBlack": "{{ ansi.black }}",
    "terminal.ansiRed": "{{ ansi.red }}",
    "terminal.ansiGreen": "{{ ansi.green }}",
    "terminal.ansiYellow": "{{ ansi.yellow }}",
    "terminal.ansiBlue": "{{ ansi.blue }}",
    "terminal.ansiMagenta": "{{ ansi.magenta }}",
    "terminal.ansiCyan": "{{ ansi.cyan }}",
    "terminal.ansiWhite": "{{ ansi.white }}",
    "terminal.ansiBrightBlack": "{{ ansi.bright_black }}",
    "terminal.ansiBrightRed": "{{ ansi.bright_red }}",
    "terminal.ansiBrightGreen": "{{ ansi.bright_green }}",
    "terminal.ansiBrightYellow": "{{ ansi.bright_yellow }}",
    "terminal.ansiBrightBlue": "{{ ansi.bright_blue }}",
    "terminal.ansiBrightMagenta": "{{ ansi.bright_magenta }}",
    "terminal.ansiBrightCyan": "{{ ansi.bright_cyan }}",
    "terminal.ansiBrightWhite": "{{ ansi.bright_white }}"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "{{ syntax.comment }}", "fontStyle": "italic" } },
    { "scope": ["storage.type.class.jsdoc", "entity.name.type.instance.jsdoc", "keyword.other.documentation"], "settings": { "foreground": "{{ syntax.comment }}", "fontStyle": "bold" } },
    { "scope": ["keyword", "keyword.control", "keyword.other", "storage.type", "storage.modifier"], "settings": { "foreground": "{{ syntax.keyword }}" } },
    { "scope": ["meta.preprocessor", "keyword.control.directive", "meta.decorator", "entity.name.function.decorator", "punctuation.decorator"], "settings": { "foreground": "{{ syntax.preproc }}" } },
    { "scope": ["keyword.operator", "punctuation", "meta.brace", "punctuation.separator", "punctuation.terminator", "punctuation.accessor", "punctuation.definition.tag"], "settings": { "foreground": "{{ syntax.operator }}" } },
    { "scope": ["string", "string.quoted", "markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "{{ syntax.string }}" } },
    { "scope": ["constant.character.escape", "string.regexp", "constant.other.placeholder"], "settings": { "foreground": "{{ syntax.escape }}" } },
    { "scope": ["constant.numeric", "constant.language", "constant.other", "variable.other.constant", "support.constant"], "settings": { "foreground": "{{ syntax.constant }}" } },
    { "scope": ["variable.language", "support.variable.builtin"], "settings": { "foreground": "{{ syntax.builtin }}" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call", "variable.function"], "settings": { "foreground": "{{ syntax.function }}" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "{{ syntax.tag }}" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "{{ syntax.attribute }}" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class"], "settings": { "foreground": "{{ syntax.type }}" } },
    { "scope": ["entity.name.namespace", "entity.name.module", "support.module"], "settings": { "foreground": "{{ syntax.namespace }}" } },
    { "scope": ["variable", "variable.parameter", "variable.other.property", "support.variable.property", "meta.object-literal.key", "variable.other.member"], "settings": { "foreground": "{{ syntax.variable }}" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "{{ syntax.heading }}", "fontStyle": "bold" } },
    { "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "{{ syntax.link }}", "fontStyle": "underline" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } }
  ],
  "semanticTokenColors": {
    "keyword": "{{ syntax.keyword }}",
    "decorator": "{{ syntax.preproc }}",
    "macro": "{{ syntax.preproc }}",
    "function": "{{ syntax.function }}",
    "method": "{{ syntax.function }}",
    "type": "{{ syntax.type }}",
    "class": "{{ syntax.type }}",
    "interface": "{{ syntax.type }}",
    "enum": "{{ syntax.type }}",
    "namespace": "{{ syntax.namespace }}",
    "enumMember": "{{ syntax.constant }}",
    "variable.readonly": "{{ syntax.constant }}",
    "property": "{{ syntax.variable }}",
    "parameter": "{{ syntax.variable }}",
    "*.deprecated": { "strikethrough": true }
  }
}
