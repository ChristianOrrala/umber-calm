{
  "manifest_version": 2,
  "name": "Umber Calm",
  "version": "{{ meta.release }}",
  "description": "A warm, low-glare dark palette with measured contrast.",
  "browser_specific_settings": { "gecko": { "id": "{8f2b0c1e-6a5d-4b7e-9c3a-2d1e0f4a5b6c}" } },
  "theme": {
    "colors": {
      "frame": "{{ ui.chrome }}",
      "tab_background_text": "{{ ui.text }}",
      "tab_selected": "{{ ui.bg }}",
      "tab_text": "{{ ui.text }}",
      "tab_line": "{{ ui.focus }}",
      "toolbar": "{{ ui.surface }}",
      "toolbar_text": "{{ ui.text }}",
      "toolbar_field": "{{ ui.bg }}",
      "toolbar_field_text": "{{ ui.text }}",
      "toolbar_field_border": "{{ ui.text_dim }}",
      "toolbar_field_focus": "{{ ui.bg }}",
      "toolbar_field_border_focus": "{{ ui.focus }}",
      "popup": "{{ ui.surface }}",
      "popup_text": "{{ ui.text }}",
      "popup_border": "{{ ui.border_strong }}",
      "popup_highlight": "{{ ui.selection_bg }}",
      "popup_highlight_text": "{{ ui.selection_fg }}",
      "sidebar": "{{ ui.surface }}",
      "sidebar_text": "{{ ui.text }}",
      "sidebar_border": "{{ ui.border_strong }}",
      "icons": "{{ ui.text_secondary }}",
      "ntp_background": "{{ ui.bg }}",
      "ntp_text": "{{ ui.text }}"
    }
  }
}
