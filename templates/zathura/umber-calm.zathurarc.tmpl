set default-bg "{{ ui.bg }}"
set default-fg "{{ ui.text }}"
set statusbar-bg "{{ ui.surface }}"
set statusbar-fg "{{ ui.text }}"
set inputbar-bg "{{ ui.surface }}"
set inputbar-fg "{{ ui.text }}"
set notification-bg "{{ ui.surface }}"
set notification-fg "{{ ui.text }}"
set notification-error-bg "{{ ui.surface }}"
set notification-error-fg "{{ diag.error }}"
set notification-warning-bg "{{ ui.surface }}"
set notification-warning-fg "{{ diag.warning }}"
set completion-bg "{{ ui.surface }}"
set completion-fg "{{ ui.text }}"
set completion-highlight-bg "{{ ui.selection_bg }}"
set completion-highlight-fg "{{ ui.text }}"
set highlight-color "{{ diag.search | blend(bg, tint.search) }}"
set highlight-active-color "{{ diag.search }}"
set recolor-lightcolor "{{ ui.bg }}"
set recolor-darkcolor "{{ ui.text }}"
