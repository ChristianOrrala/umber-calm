{
  "schemaVersion": 1,
  "base": "dark",
  "tokens": {
    "--background": "{{ ui.bg }}",
    "--editor-surface": "{{ ui.bg }}",
    "--foreground": "{{ ui.text }}",
    "--card": "{{ ui.surface }}",
    "--card-foreground": "{{ ui.text }}",
    "--popover": "{{ ui.surface }}",
    "--popover-foreground": "{{ ui.text }}",
    "--primary": "{{ ui.text }}",
    "--primary-foreground": "{{ ui.bg }}",
    "--secondary": "{{ ui.selection_bg }}",
    "--secondary-foreground": "{{ ui.text }}",
    "--muted": "{{ ui.surface }}",
    "--muted-foreground": "{{ ui.text_secondary }}",
    "--accent": "{{ ui.selection_bg }}",
    "--accent-foreground": "{{ ui.selection_fg }}",
    "--border": "{{ ui.border_strong }}",
    "--input": "{{ ui.border }}",
    "--ring": "{{ ui.focus }}",
    "--chart-1": "{{ blue }}",
    "--chart-2": "{{ green }}",
    "--chart-3": "{{ yellow }}",
    "--chart-4": "{{ purple }}",
    "--chart-5": "{{ cyan }}",
    "--sidebar": "{{ ui.chrome }}",
    "--sidebar-foreground": "{{ ui.text }}",
    "--sidebar-primary": "{{ ui.text }}",
    "--sidebar-primary-foreground": "{{ ui.bg }}",
    "--sidebar-accent": "{{ ui.selection_bg }}",
    "--sidebar-accent-foreground": "{{ ui.selection_fg }}",
    "--sidebar-border": "{{ ui.border_strong }}",
    "--sidebar-ring": "{{ ui.focus }}",
    "--worktree-sidebar": "{{ ui.chrome }}",
    "--worktree-sidebar-foreground": "{{ ui.text }}",
    "--worktree-sidebar-accent": "{{ ui.surface }}",
    "--worktree-sidebar-accent-foreground": "{{ ui.text }}",
    "--worktree-sidebar-border": "{{ ui.border_strong }}",
    "--worktree-sidebar-ring": "{{ ui.focus }}",
    "--worktree-sidebar-active": "{{ ui.selection_bg }}",
    "--worktree-sidebar-active-border": "{{ ui.border_strong }}",
    "--host-badge": "{{ ui.text | alpha(17) }}",
    "--host-badge-foreground": "{{ ui.text }}",
    "--tab-bar": "{{ ui.chrome }}",
    "--tab-active": "{{ ui.bg }}",
    "--tab-active-foreground": "{{ ui.text }}",
    "--tab-active-indicator": "{{ ui.focus }}",
    "--tab-inactive": "{{ ui.chrome }}",
    "--tab-inactive-foreground": "{{ ui.text_secondary }}",
    "--split-divider": "{{ ui.border }}",
    "--split-divider-hover": "{{ ui.text_secondary }}",
    "--chat-user-message": "{{ ui.text | alpha(12) }}",
    "--chat-bold-foreground": "{{ text_bright }}",
    "--chat-muted-foreground": "{{ ui.text_secondary }}",
    "--chat-inline-code": "{{ ui.bg }}",
    "--chat-inline-code-foreground": "{{ syntax.code }}",
    "--chat-code-block": "{{ ui.bg }}",
    "--chat-selection": "{{ ui.selection_bg }}",
    "--chat-selection-foreground": "{{ ui.selection_fg }}",
    "--text-link": "{{ syntax.link }}",
    "--diff-added": "{{ diag.diff_add }}",
    "--diff-added-background": "{{ diag.diff_add | alpha(1E) }}",
    "--diff-added-emphasis": "{{ diag.diff_add | alpha(1D) }}",
    "--diff-added-gutter": "{{ diag.diff_add | alpha(38) }}",
    "--diff-removed": "{{ diag.diff_delete }}",
    "--diff-removed-background": "{{ diag.diff_delete | alpha(1E) }}",
    "--diff-removed-emphasis": "{{ diag.diff_delete | alpha(1D) }}",
    "--diff-removed-gutter": "{{ diag.diff_delete | alpha(38) }}",
    "--git-decoration-added": "{{ diag.diff_add }}",
    "--git-decoration-modified": "{{ diag.diff_change }}",
    "--git-decoration-deleted": "{{ diag.diff_delete }}",
    "--git-decoration-renamed": "{{ diag.ok }}",
    "--git-decoration-untracked": "{{ diag.ok }}",
    "--git-decoration-copied": "{{ diag.ok }}",
    "--git-decoration-ignored": "{{ ui.text_secondary }}"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "{{ syntax.comment }}", "fontStyle": "italic" } },
    { "scope": ["storage.type.class.jsdoc", "entity.name.type.instance.jsdoc", "keyword.other.documentation"], "settings": { "foreground": "{{ syntax.comment }}", "fontStyle": "bold" } },
    { "scope": ["keyword", "keyword.control", "keyword.other", "storage.type", "storage.modifier"], "settings": { "foreground": "{{ syntax.keyword }}" } },
    { "scope": ["meta.preprocessor", "keyword.control.directive", "meta.decorator", "entity.name.function.decorator", "punctuation.decorator"], "settings": { "foreground": "{{ syntax.preproc }}" } },
    { "scope": ["keyword.operator", "punctuation", "meta.brace", "punctuation.separator", "punctuation.terminator", "punctuation.accessor", "punctuation.definition.tag"], "settings": { "foreground": "{{ syntax.operator }}" } },
    { "scope": ["string", "string.quoted", "markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "{{ syntax.string }}" } },
    { "scope": ["constant.character.escape", "string.regexp", "constant.other.placeholder"], "settings": { "foreground": "{{ syntax.escape }}" } },
    { "scope": ["constant.numeric", "constant.language", "constant.other", "variable.other.enummember", "support.constant", "keyword.other.unit"], "settings": { "foreground": "{{ syntax.constant }}" } },
    { "scope": ["variable.language", "support.variable.builtin", "variable.parameter.function.language.special"], "settings": { "foreground": "{{ syntax.builtin }}" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call", "variable.function"], "settings": { "foreground": "{{ syntax.function }}" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "{{ syntax.tag }}" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "{{ syntax.attribute }}" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class"], "settings": { "foreground": "{{ syntax.type }}" } },
    { "scope": ["entity.name.namespace", "entity.name.module", "support.module"], "settings": { "foreground": "{{ syntax.namespace }}" } },
    { "scope": ["variable", "variable.parameter", "variable.other.property", "support.variable.property", "meta.object-literal.key", "variable.other.member", "variable.other.constant", "support.type.property-name"], "settings": { "foreground": "{{ syntax.variable }}" } },
    { "scope": ["keyword.operator.expression", "keyword.operator.new", "keyword.operator.delete", "keyword.operator.sizeof", "keyword.operator.alignof", "keyword.operator.typeid", "keyword.operator.cast", "keyword.operator.wordlike", "keyword.operator.word", "keyword.operator.logical.python"], "settings": { "foreground": "{{ syntax.keyword }}" } },
    { "scope": ["storage.type.function.arrow"], "settings": { "foreground": "{{ syntax.operator }}" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "{{ syntax.heading }}", "fontStyle": "bold" } },
    { "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "{{ syntax.link }}", "fontStyle": "underline" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "{{ diag.diff_add }}" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "{{ diag.diff_delete }}" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "{{ diag.diff_change }}" } }
  ]
}
