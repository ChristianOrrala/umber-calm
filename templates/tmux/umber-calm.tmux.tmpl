# Hex is lowercase on purpose: tmux expands styles as formats (#{E:mode-style} and friends),
# where #D and #F are aliases, so fg=#D6C9B6 would turn into fg=%46C9B6.
set -g status-style "bg={{ ui.surface | lower }},fg={{ ui.text_secondary | lower }}"
set -g status-left-style "bg={{ ui.surface | lower }},fg={{ ui.text | lower }}"
set -g status-right-style "bg={{ ui.surface | lower }},fg={{ ui.text_secondary | lower }}"
set -g window-status-style "bg={{ ui.surface | lower }},fg={{ ui.text_secondary | lower }}"
set -g window-status-current-style "bg={{ ui.surface | lower }},fg={{ ui.focus | lower }},bold"
set -g window-status-activity-style "bg={{ ui.surface | lower }},fg={{ diag.warning | lower }}"
set -g pane-border-style "fg={{ ui.border | lower }}"
set -g pane-active-border-style "fg={{ ui.focus | lower }}"
set -g message-style "bg={{ ui.surface | lower }},fg={{ ui.text | lower }}"
set -g message-command-style "bg={{ ui.surface | lower }},fg={{ ui.text | lower }}"
set -g mode-style "bg={{ ui.selection_bg | lower }},fg={{ ui.selection_fg | lower }}"
set -g copy-mode-match-style "bg={{ diag.search | blend(ui.bg, tint.search) | lower }},fg={{ ui.text | lower }}"
set -g copy-mode-current-match-style "bg={{ diag.search | lower }},fg={{ ui.bg | lower }}"
set -g display-panes-active-colour "{{ ui.focus | lower }}"
set -g display-panes-colour "{{ ui.border | lower }}"
set -g clock-mode-colour "{{ ui.text | lower }}"
