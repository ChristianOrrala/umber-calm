# Umber Calm {{ meta.palette_version }} — generated from {{ meta.template }}. Do not edit. MIT License.
set -g status-style "bg={{ ui.surface }},fg={{ ui.text_secondary }}"
set -g status-left-style "bg={{ ui.surface }},fg={{ ui.text }}"
set -g status-right-style "bg={{ ui.surface }},fg={{ ui.text_secondary }}"
set -g window-status-style "bg={{ ui.surface }},fg={{ ui.text_secondary }}"
set -g window-status-current-style "bg={{ ui.surface }},fg={{ ui.focus }},bold"
set -g window-status-activity-style "bg={{ ui.surface }},fg={{ diag.warning }}"
set -g pane-border-style "fg={{ ui.border }}"
set -g pane-active-border-style "fg={{ ui.focus }}"
set -g message-style "bg={{ ui.surface }},fg={{ ui.text }}"
set -g message-command-style "bg={{ ui.surface }},fg={{ ui.text }}"
set -g mode-style "bg={{ ui.selection_bg }},fg={{ ui.selection_fg }}"
set -g copy-mode-match-style "bg={{ diag.search | blend(ui.bg, tint.search) }},fg={{ ui.text }}"
set -g copy-mode-current-match-style "bg={{ diag.search }},fg={{ ui.bg }}"
set -g display-panes-active-colour "{{ ui.focus }}"
set -g display-panes-colour "{{ ui.border }}"
set -g clock-mode-colour "{{ ui.text }}"
