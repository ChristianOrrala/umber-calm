{
  "dark": {
    "--bg": "{{ ui.bg }}",
    "--bg-accent": "{{ ui.surface }}",
    "--bg-elevated": "{{ ui.surface }}",
    "--bg-hover": "{{ ui.text | alpha(0F) }}",
    "--card": "{{ ui.surface }}",
    "--card-fg": "{{ ui.text }}",
    "--card-hl": "{{ ui.text | alpha(0D) }}",
    "--panel": "{{ ui.surface }}",
    "--panel-strong": "{{ ui.surface }}",
    "--chrome": "{{ ui.chrome }}",
    "--text": "{{ ui.text }}",
    "--text-strong": "{{ text_bright }}",
    "--muted": "{{ ui.text_secondary }}",
    "--muted-strong": "{{ ui.text_secondary }}",
    "--muted-fg": "{{ ui.bg }}",
    "--border": "{{ ui.border_strong }}",
    "--border-strong": "{{ ui.border }}",
    "--border-hover": "{{ ui.text_dim }}",
    "--accent": "{{ blue }}",
    "--accent-fg": "{{ ui.bg }}",
    "--accent-hover": "{{ ansi.bright_blue }}",
    "--accent-subtle": "{{ ui.selection_bg }}",
    "--accent-glow": "{{ blue | alpha(40) }}",
    "--ring": "{{ ui.focus }}",
    "--ok": "{{ diag.ok }}",
    "--ok-fg": "{{ ui.bg }}",
    "--ok-subtle": "{{ diag.ok | blend(ui.bg, tint.diag) }}",
    "--warn": "{{ diag.warning }}",
    "--warn-fg": "{{ ui.bg }}",
    "--warn-subtle": "{{ diag.warning | blend(ui.bg, tint.diag) }}",
    "--danger": "{{ diag.error }}",
    "--danger-fg": "{{ ui.bg }}",
    "--danger-subtle": "{{ diag.error | blend(ui.bg, tint.diag) }}",
    "--info": "{{ diag.info }}",
    "--info-fg": "{{ ui.bg }}",
    "--aim": "{{ ansi.magenta }}",
    "--aim-fg": "{{ ui.bg }}",
    "--aim-subtle": "{{ ui.selection_bg }}",
    "--clarify": "{{ diag.warning }}",
    "--clarify-subtle": "{{ diag.warning | blend(ui.bg, tint.diag) }}",
    "--json-key": "{{ syntax.variable }}",
    "--json-str": "{{ syntax.string }}",
    "--json-num": "{{ syntax.constant }}",
    "--json-bool": "{{ syntax.constant }}",
    "--diff-add": "{{ diag.diff_add | blend(ui.bg, tint.diag) }}",
    "--diff-add-text": "{{ diag.diff_add }}",
    "--diff-del": "{{ diag.diff_delete | blend(ui.bg, tint.diag) }}",
    "--diff-del-text": "{{ diag.diff_delete }}",
    "--diff-hunk": "{{ diag.diff_change | blend(ui.bg, tint.diag) }}",
    "--diff-hunk-text": "{{ diag.diff_change }}",
    "--diff-meta-text": "{{ ui.text }}",
    "--shadow-sm": "0 1px 2px rgba(0,0,0,.3)",
    "--shadow-md": "0 4px 12px rgba(0,0,0,.35),0 0 0 1px rgba(0,0,0,.2)",
    "--shadow-lg": "0 12px 28px rgba(0,0,0,.45)",
    "--term-magenta": "{{ ansi.magenta }}",
    "--term-cyan": "{{ ansi.cyan }}"
  },
  "light": {
    "--bg": "{{ ui.bg }}",
    "--bg-accent": "{{ ui.surface }}",
    "--bg-elevated": "{{ ui.surface }}",
    "--bg-hover": "{{ ui.text | alpha(0F) }}",
    "--card": "{{ ui.surface }}",
    "--card-fg": "{{ ui.text }}",
    "--card-hl": "{{ ui.text | alpha(0D) }}",
    "--panel": "{{ ui.surface }}",
    "--panel-strong": "{{ ui.surface }}",
    "--chrome": "{{ ui.chrome }}",
    "--text": "{{ ui.text }}",
    "--text-strong": "{{ text_bright }}",
    "--muted": "{{ ui.text_secondary }}",
    "--muted-strong": "{{ ui.text_secondary }}",
    "--muted-fg": "{{ ui.bg }}",
    "--border": "{{ ui.border_strong }}",
    "--border-strong": "{{ ui.border }}",
    "--border-hover": "{{ ui.text_dim }}",
    "--accent": "{{ blue }}",
    "--accent-fg": "{{ ui.bg }}",
    "--accent-hover": "{{ ansi.bright_blue }}",
    "--accent-subtle": "{{ ui.selection_bg }}",
    "--accent-glow": "{{ blue | alpha(40) }}",
    "--ring": "{{ ui.focus }}",
    "--ok": "{{ diag.ok }}",
    "--ok-fg": "{{ ui.bg }}",
    "--ok-subtle": "{{ diag.ok | blend(ui.bg, tint.diag) }}",
    "--warn": "{{ diag.warning }}",
    "--warn-fg": "{{ ui.bg }}",
    "--warn-subtle": "{{ diag.warning | blend(ui.bg, tint.diag) }}",
    "--danger": "{{ diag.error }}",
    "--danger-fg": "{{ ui.bg }}",
    "--danger-subtle": "{{ diag.error | blend(ui.bg, tint.diag) }}",
    "--info": "{{ diag.info }}",
    "--info-fg": "{{ ui.bg }}",
    "--aim": "{{ ansi.magenta }}",
    "--aim-fg": "{{ ui.bg }}",
    "--aim-subtle": "{{ ui.selection_bg }}",
    "--clarify": "{{ diag.warning }}",
    "--clarify-subtle": "{{ diag.warning | blend(ui.bg, tint.diag) }}",
    "--json-key": "{{ syntax.variable }}",
    "--json-str": "{{ syntax.string }}",
    "--json-num": "{{ syntax.constant }}",
    "--json-bool": "{{ syntax.constant }}",
    "--diff-add": "{{ diag.diff_add | blend(ui.bg, tint.diag) }}",
    "--diff-add-text": "{{ diag.diff_add }}",
    "--diff-del": "{{ diag.diff_delete | blend(ui.bg, tint.diag) }}",
    "--diff-del-text": "{{ diag.diff_delete }}",
    "--diff-hunk": "{{ diag.diff_change | blend(ui.bg, tint.diag) }}",
    "--diff-hunk-text": "{{ diag.diff_change }}",
    "--diff-meta-text": "{{ ui.text }}",
    "--shadow-sm": "0 1px 2px rgba(0,0,0,.3)",
    "--shadow-md": "0 4px 12px rgba(0,0,0,.35),0 0 0 1px rgba(0,0,0,.2)",
    "--shadow-lg": "0 12px 28px rgba(0,0,0,.45)",
    "--term-magenta": "{{ ansi.magenta }}",
    "--term-cyan": "{{ ansi.cyan }}"
  }
}
