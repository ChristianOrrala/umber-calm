{
  "name": "Umber Calm",
  "dark": true,
  "author": "The Umber Calm contributors",
  "editorScheme": "/UmberCalm.xml",
  "ui": {
    "*": {
      "background": "{{ ui.surface }}",
      "foreground": "{{ ui.text }}",
      "infoForeground": "{{ ui.text_secondary }}",
      "selectionBackground": "{{ ui.selection_bg }}",
      "selectionForeground": "{{ ui.selection_fg }}",
      "selectionInactiveBackground": "{{ ui.selection_bg }}",
      "borderColor": "{{ ui.border_strong }}",
      "separatorColor": "{{ ui.border_strong }}",
      "focusColor": "{{ ui.focus }}",
      "disabledForeground": "{{ ui.text_dim }}"
    },
    "EditorTabs": { "underlinedTabBackground": "{{ ui.bg }}", "underlineColor": "{{ ui.focus }}", "background": "{{ ui.chrome }}" },
    "ToolWindow": { "background": "{{ ui.surface }}" },
    "StatusBar": { "background": "{{ ui.surface }}" },
    "Button": { "default.startBackground": "{{ blue }}", "default.endBackground": "{{ blue }}", "default.foreground": "{{ ui.bg }}" },
    "Link": { "activeForeground": "{{ blue }}" }
  }
}
