# Umber Calm 0.1.0 — generated from templates/tmux/umber-calm.tmux.tmpl. Do not edit. MIT License.
# Hex is lowercase on purpose: tmux expands styles as formats (#{E:mode-style} and friends),
# where #D and #F are aliases, so fg=#D6C9B6 would turn into fg=%46C9B6.
set -g status-style "bg=#2a2826,fg=#938a7b"
set -g status-left-style "bg=#2a2826,fg=#d6c9b6"
set -g status-right-style "bg=#2a2826,fg=#938a7b"
set -g window-status-style "bg=#2a2826,fg=#938a7b"
set -g window-status-current-style "bg=#2a2826,fg=#eda97c,bold"
set -g window-status-activity-style "bg=#2a2826,fg=#dcc07d"
set -g pane-border-style "fg=#5a554e"
set -g pane-active-border-style "fg=#eda97c"
set -g message-style "bg=#2a2826,fg=#d6c9b6"
set -g message-command-style "bg=#2a2826,fg=#d6c9b6"
set -g mode-style "bg=#3c3a36,fg=#d6c9b6"
set -g copy-mode-match-style "bg=#423c2e,fg=#d6c9b6"
set -g copy-mode-current-match-style "bg=#dcc07d,fg=#201f1d"
set -g display-panes-active-colour "#eda97c"
set -g display-panes-colour "#5a554e"
set -g clock-mode-colour "#d6c9b6"
