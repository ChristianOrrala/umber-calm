{
  "base": {
    "categorical": ["blue", "purple", "green", "cyan", "yellow"],
    "text": {
      "base": "$hue.neutral.200",
      "muted": "$hue.neutral.400",
      "faint": "$hue.neutral.500",
      "action": {
        "primary": {
          "base": "$text.base",
          "$disabled": "$text.faint",
          "$focused": "$hue.neutral.800",
          "$selected": "$hue.orange.200"
        },
        "secondary": {
          "base": "$text.muted",
          "$hovered": "$text.base",
          "$focused": "$hue.neutral.800"
        },
        "destructive": {
          "base": "$hue.neutral.800",
          "$disabled": "$text.faint"
        }
      },
      "formfield": {
        "base": "$text.base",
        "$disabled": "$text.faint",
        "$focused": "$hue.orange.200",
        "$selected": "$hue.green.200"
      },
      "feedback": {
        "error": { "base": "$hue.red.200" },
        "warning": { "base": "$hue.yellow.200" },
        "success": { "base": "$hue.green.200" },
        "info": { "base": "$hue.cyan.200" }
      }
    },
    "background": {
      "base": "$hue.neutral.800",
      "raised": {
        "base": "$hue.neutral.700",
        "high": "#3C3A36",
        "max": "#3C3A36"
      },
      "action": {
        "primary": {
          "base": "transparent",
          "$hovered": "$hue.neutral.700",
          "$focused": "$hue.orange.200",
          "$selected": "transparent"
        },
        "secondary": { "base": "transparent" },
        "destructive": { "base": "$hue.red.200" }
      },
      "formfield": { "base": "$background.base" },
      "feedback": {
        "error": { "base": "$background.base" },
        "warning": { "base": "$background.base" },
        "success": { "base": "$background.base" },
        "info": { "base": "$background.base" }
      }
    },
    "border": { "base": "#5A554E" },
    "scrollbar": { "base": "$hue.neutral.500" },
    "diff": {
      "text": {
        "added": "#A7B56E",
        "removed": "#EC9A8C",
        "context": "#988F7F",
        "hunkHeader": "#988F7F"
      },
      "background": {
        "added": "#3E402F",
        "removed": "#4A3530",
        "context": "$hue.neutral.700"
      },
      "highlight": {
        "added": "#A7B56E",
        "removed": "#E08374"
      },
      "lineNumber": {
        "text": "#988F7F",
        "background": {
          "added": "#303127",
          "removed": "#372B27"
        }
      }
    },
    "syntax": {
      "comment": "#988F7F",
      "keyword": "#DCC07D",
      "function": "#88B0B4",
      "variable": "#D6C9B6",
      "string": "#A7B56E",
      "number": "#C9A0C0",
      "type": "#88C0AE",
      "operator": "#C2A98C",
      "punctuation": "#C2A98C"
    },
    "markdown": {
      "text": "#D6C9B6",
      "heading": "#DCC07D",
      "link": "#88B0B4",
      "linkText": "#88B0B4",
      "code": "#A7B56E",
      "blockQuote": "#988F7F",
      "emphasis": "#D6C9B6",
      "strong": "#D6C9B6",
      "horizontalRule": "#5A554E",
      "listItem": "#C2A98C",
      "listEnumeration": "#C2A98C",
      "image": "#88B0B4",
      "imageText": "#88B0B4",
      "codeBlock": "#D6C9B6"
    },
    "@dialog": {
      "background": {
        "base": "$background.raised.base",
        "action": {
          "primary": { "$hovered": "$background.raised.high" }
        }
      }
    }
  },
  "dark": {
    "hue": {
      "neutral": {
        "100": "#EDE3D2",
        "200": "#D6C9B6",
        "300": "#C2A98C",
        "400": "#988F7F",
        "500": "#77726A",
        "600": "#2A2826",
        "700": "#2A2826",
        "800": "#201F1D",
        "900": "#1A1917"
      },
      "red": {
        "100": "#EC9A8C",
        "200": "#E08374",
        "300": "#E08374",
        "400": "#E08374",
        "500": "#E08374",
        "600": "#E08374",
        "700": "#E08374",
        "800": "#E08374",
        "900": "#E08374"
      },
      "orange": {
        "100": "#EDA97C",
