{
  "schemaVersion": 1,
  "base": "dark",
  "tokens": {
    "--background": "#201F1D",
    "--editor-surface": "#201F1D",
    "--foreground": "#D6C9B6",
    "--card": "#2A2826",
    "--card-foreground": "#D6C9B6",
    "--popover": "#2A2826",
    "--popover-foreground": "#D6C9B6",
    "--primary": "#D6C9B6",
    "--primary-foreground": "#201F1D",
    "--secondary": "#3C3A36",
    "--secondary-foreground": "#D6C9B6",
    "--muted": "#2A2826",
    "--muted-foreground": "#988F7F",
    "--accent": "#3C3A36",
    "--accent-foreground": "#D6C9B6",
    "--border": "#3C3A36",
    "--input": "#5A554E",
    "--ring": "#EDA97C",
    "--chart-1": "#88B0B4",
    "--chart-2": "#A7B56E",
    "--chart-3": "#DCC07D",
    "--chart-4": "#C9A0C0",
    "--chart-5": "#88C0AE",
    "--sidebar": "#1A1917",
    "--sidebar-foreground": "#D6C9B6",
    "--sidebar-primary": "#D6C9B6",
    "--sidebar-primary-foreground": "#201F1D",
    "--sidebar-accent": "#3C3A36",
    "--sidebar-accent-foreground": "#D6C9B6",
    "--sidebar-border": "#3C3A36",
    "--sidebar-ring": "#EDA97C",
    "--worktree-sidebar": "#1A1917",
    "--worktree-sidebar-foreground": "#D6C9B6",
    "--worktree-sidebar-accent": "#2A2826",
    "--worktree-sidebar-accent-foreground": "#D6C9B6",
    "--worktree-sidebar-border": "#3C3A36",
    "--worktree-sidebar-ring": "#EDA97C",
    "--worktree-sidebar-active": "#3C3A36",
    "--worktree-sidebar-active-border": "#3C3A36",
    "--host-badge": "#D6C9B617",
    "--host-badge-foreground": "#D6C9B6",
    "--tab-bar": "#1A1917",
    "--tab-active": "#201F1D",
    "--tab-active-foreground": "#D6C9B6",
    "--tab-active-indicator": "#EDA97C",
    "--tab-inactive": "#1A1917",
    "--tab-inactive-foreground": "#988F7F",
    "--split-divider": "#5A554E",
    "--split-divider-hover": "#988F7F",
    "--chat-user-message": "#D6C9B612",
    "--chat-bold-foreground": "#EDE3D2",
    "--chat-muted-foreground": "#988F7F",
    "--chat-inline-code": "#201F1D",
    "--chat-inline-code-foreground": "#A7B56E",
    "--chat-code-block": "#201F1D",
    "--chat-selection": "#3C3A36",
    "--chat-selection-foreground": "#D6C9B6",
    "--text-link": "#88B0B4",
    "--diff-added": "#A7B56E",
    "--diff-added-background": "#A7B56E1E",
    "--diff-added-emphasis": "#A7B56E1D",
    "--diff-added-gutter": "#A7B56E38",
    "--diff-removed": "#E08374",
    "--diff-removed-background": "#E083741E",
    "--diff-removed-emphasis": "#E083741D",
    "--diff-removed-gutter": "#E0837438",
    "--git-decoration-added": "#A7B56E",
    "--git-decoration-modified": "#88B0B4",
    "--git-decoration-deleted": "#E08374",
    "--git-decoration-renamed": "#A7B56E",
    "--git-decoration-untracked": "#A7B56E",
    "--git-decoration-copied": "#A7B56E",
    "--git-decoration-ignored": "#988F7F"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#988F7F", "fontStyle": "italic" } },
    { "scope": ["storage.type.class.jsdoc", "entity.name.type.instance.jsdoc", "keyword.other.documentation"], "settings": { "foreground": "#988F7F", "fontStyle": "bold" } },
    { "scope": ["keyword", "keyword.control", "keyword.other", "storage.type", "storage.modifier"], "settings": { "foreground": "#DCC07D" } },
    { "scope": ["meta.preprocessor", "keyword.control.directive", "meta.decorator", "entity.name.function.decorator", "punctuation.decorator"], "settings": { "foreground": "#DCC07D" } },
    { "scope": ["keyword.operator", "punctuation", "meta.brace", "punctuation.separator", "punctuation.terminator", "punctuation.accessor", "punctuation.definition.tag"], "settings": { "foreground": "#C2A98C" } },
    { "scope": ["string", "string.quoted", "markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "#A7B56E" } },
    { "scope": ["constant.character.escape", "string.regexp", "constant.other.placeholder"], "settings": { "foreground": "#C9A0C0" } },
    { "scope": ["constant.numeric", "constant.language", "constant.other", "variable.other.enummember", "support.constant", "keyword.other.unit"], "settings": { "foreground": "#C9A0C0" } },
    { "scope": ["variable.language", "support.variable.builtin", "variable.parameter.function.language.special"], "settings": { "foreground": "#C9A0C0" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call", "variable.function"], "settings": { "foreground": "#88B0B4" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#88B0B4" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#88C0AE" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class"], "settings": { "foreground": "#88C0AE" } },
    { "scope": ["entity.name.namespace", "entity.name.module", "support.module"], "settings": { "foreground": "#88C0AE" } },
    { "scope": ["variable", "variable.parameter", "variable.other.property", "support.variable.property", "meta.object-literal.key", "variable.other.member", "variable.other.constant", "support.type.property-name"], "settings": { "foreground": "#D6C9B6" } },
    { "scope": ["keyword.operator.expression", "keyword.operator.new", "keyword.operator.delete", "keyword.operator.sizeof", "keyword.operator.alignof", "keyword.operator.typeid", "keyword.operator.cast", "keyword.operator.wordlike", "keyword.operator.word", "keyword.operator.logical.python"], "settings": { "foreground": "#DCC07D" } },
    { "scope": ["storage.type.function.arrow"], "settings": { "foreground": "#C2A98C" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#DCC07D", "fontStyle": "bold" } },
    { "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#88B0B4", "fontStyle": "underline" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#A7B56E" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#E08374" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "#88B0B4" } }
  ]
}
