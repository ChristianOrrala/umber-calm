  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#938A7B", "fontStyle": "italic" } },
    { "scope": ["storage.type.class.jsdoc", "entity.name.type.instance.jsdoc", "keyword.other.documentation"], "settings": { "foreground": "#938A7B", "fontStyle": "bold" } },
    { "scope": ["keyword", "keyword.control", "keyword.other", "storage.type", "storage.modifier"], "settings": { "foreground": "#DCC07D" } },
    { "scope": ["meta.preprocessor", "keyword.control.directive", "meta.decorator", "entity.name.function.decorator", "punctuation.decorator"], "settings": { "foreground": "#DCC07D" } },
    { "scope": ["keyword.operator", "punctuation", "meta.brace", "punctuation.separator", "punctuation.terminator", "punctuation.accessor", "punctuation.definition.tag"], "settings": { "foreground": "#C2A98C" } },
    { "scope": ["string", "string.quoted", "markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "#A7B56E" } },
    { "scope": ["constant.character.escape", "string.regexp", "constant.other.placeholder"], "settings": { "foreground": "#C9A0C0" } },
    { "scope": ["constant.numeric", "constant.language", "constant.other", "variable.other.constant", "support.constant"], "settings": { "foreground": "#C9A0C0" } },
    { "scope": ["variable.language", "support.variable.builtin"], "settings": { "foreground": "#C9A0C0" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call", "variable.function"], "settings": { "foreground": "#88B0B4" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#88B0B4" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#88C0AE" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class"], "settings": { "foreground": "#88C0AE" } },
    { "scope": ["entity.name.namespace", "entity.name.module", "support.module"], "settings": { "foreground": "#88C0AE" } },
    { "scope": ["variable", "variable.parameter", "variable.other.property", "support.variable.property", "meta.object-literal.key", "variable.other.member"], "settings": { "foreground": "#D6C9B6" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#DCC07D", "fontStyle": "bold" } },
    { "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#88B0B4", "fontStyle": "underline" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } }
  ],
  "semanticTokenColors": {
    "keyword": "#DCC07D",
    "decorator": "#DCC07D",
    "macro": "#DCC07D",
    "function": "#88B0B4",
    "method": "#88B0B4",
    "type": "#88C0AE",
    "class": "#88C0AE",
    "interface": "#88C0AE",
    "enum": "#88C0AE",
    "namespace": "#88C0AE",
    "enumMember": "#C9A0C0",
    "variable.readonly": "#C9A0C0",
    "property": "#D6C9B6",
    "parameter": "#D6C9B6",
    "*.deprecated": { "strikethrough": true }
  }
}
