{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Umber Calm",
  "author": "The Umber Calm contributors",
  "themes": [
    {
      "name": "Umber Calm",
      "appearance": "dark",
      "style": {
        "background": "#1A1917",
        "border": "#3C3A36",
        "border.variant": "#5A554E",
        "border.focused": "#EDA97C",
        "text": "#D6C9B6",
        "text.muted": "#938A7B",
        "text.placeholder": "#6E6961",
        "text.accent": "#88B0B4",
        "icon": "#D6C9B6",
        "icon.muted": "#938A7B",
        "element.hover": "#2A2826",
        "element.selected": "#3C3A36",
        "surface.background": "#2A2826",
        "elevated_surface.background": "#2A2826",
        "panel.background": "#2A2826",
        "status_bar.background": "#2A2826",
        "title_bar.background": "#1A1917",
        "tab_bar.background": "#1A1917",
        "tab.active_background": "#201F1D",
        "tab.inactive_background": "#1A1917",
        "editor.background": "#201F1D",
        "editor.foreground": "#D6C9B6",
        "editor.gutter.background": "#201F1D",
        "editor.active_line.background": "#2A2826",
        "editor.line_number": "#938A7B",
        "editor.active_line_number": "#D6C9B6",
        "editor.indent_guide": "#3C3A36",
        "editor.indent_guide_active": "#5A554E",
        "search.match_background": "#DCC07D2E",
        "error": "#E08374",
        "warning": "#DCC07D",
        "info": "#88B0B4",
        "hint": "#88C0AE",
        "success": "#A7B56E",
        "created": "#A7B56E",
        "deleted": "#E08374",
        "modified": "#88B0B4",
        "terminal.background": "#201F1D",
        "terminal.foreground": "#D6C9B6",
        "terminal.ansi.black": "#2A2826",
        "terminal.ansi.red": "#E08374",
        "terminal.ansi.green": "#A7B56E",
        "terminal.ansi.yellow": "#DCC07D",
        "terminal.ansi.blue": "#88B0B4",
        "terminal.ansi.magenta": "#C9A0C0",
        "terminal.ansi.cyan": "#88C0AE",
        "terminal.ansi.white": "#D6C9B6",
        "terminal.ansi.bright_black": "#6E6961",
        "terminal.ansi.bright_red": "#EC9A8C",
        "terminal.ansi.bright_green": "#B9C684",
        "terminal.ansi.bright_yellow": "#E8CE92",
        "terminal.ansi.bright_blue": "#9DC2C5",
        "terminal.ansi.bright_magenta": "#D7B4CF",
        "terminal.ansi.bright_cyan": "#9CCEBC",
        "terminal.ansi.bright_white": "#EDE3D2",
        "players": [
          { "cursor": "#EDA97C", "background": "#EDA97C", "selection": "#3C3A36" }
        ],
        "syntax": {
          "keyword": { "color": "#DCC07D" },
          "preproc": { "color": "#DCC07D" },
          "function": { "color": "#88B0B4" },
          "tag": { "color": "#88B0B4" },
          "type": { "color": "#88C0AE" },
          "constructor": { "color": "#88C0AE" },
          "attribute": { "color": "#88C0AE" },
          "string": { "color": "#A7B56E" },
          "string.escape": { "color": "#C9A0C0" },
          "string.regex": { "color": "#C9A0C0" },
          "number": { "color": "#C9A0C0" },
          "boolean": { "color": "#C9A0C0" },
          "constant": { "color": "#C9A0C0" },
          "variable": { "color": "#D6C9B6" },
          "variable.special": { "color": "#C9A0C0" },
          "property": { "color": "#D6C9B6" },
          "operator": { "color": "#C2A98C" },
          "punctuation": { "color": "#C2A98C" },
          "comment": { "color": "#938A7B", "font_style": "italic" },
          "title": { "color": "#DCC07D", "font_weight": 700 },
          "link_uri": { "color": "#88B0B4" }
        }
      }
    }
  ]
}
